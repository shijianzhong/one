{
  "mcpServers": {
    "claude-code": {
      "transport": "stdio",
      "command": "python3",
      "args": ["./scripts/claude_code_mcp_server.py"],
      "env": {
        "CLAUDE_CODE_AUTO_MODE": "1"
      }
    },
    "stitch": {
      "transport": "http",
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "GCP_API_KEY_PLACEHOLDER"
      }
    }
  }
}